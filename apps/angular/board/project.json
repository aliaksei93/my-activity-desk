{
  "name": "board",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/angular/board/src",
  "tags": ["scope:platform", "type:remote", "framework:angular"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{workspaceRoot}/dist/apps/angular/board"],
      "options": {
        "outputPath": {
          "base": "dist/apps/angular/board",
          "browser": "."
        },
        "index": {
          "input": "apps/angular/board/src/index.html",
          "output": "index.html"
        },
        "browser": "apps/angular/board/src/main.ts",
        "server": false,
        "tsConfig": "apps/angular/board/tsconfig.app.json",
        "polyfills": ["zone.js"],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/angular/board/public"
          }
        ],
        "styles": ["apps/angular/board/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/design/tokens/src/styles"]
        },
        "inlineStyleLanguage": "scss"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "none"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/angular/board/src/environments/environment.ts",
              "with": "apps/angular/board/src/environments/environment.development.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "buildTarget": "board:build:development",
        "port": 4201,
        "host": "localhost",
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "board:build:production"
        },
        "development": {
          "buildTarget": "board:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/angular/board/jest.config.ts",
        "tsConfig": "apps/angular/board/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "board:build",
        "port": 4201,
        "watch": false
      },
      "configurations": {
        "development": {
          "buildTarget": "board:build:development"
        },
        "production": {
          "buildTarget": "board:build:production"
        }
      }
    }
  }
}
